# Copie este arquivo para ".env.local" (na mesma pasta) e ajuste.
# O .env.local nunca vai para o git: é onde vão ficar os segredos (chave da IA, senha do banco).
# Depois de alterar, reinicie o servidor.

# Quem gera as respostas:
#   faq  = perguntas e respostas de Perguntas/Perguntas.json (padrão)
#   mock = respostas simuladas, para testar a tela
CHATBOT_RESPOSTA=faq

# Arquivo de perguntas (opcional; o padrão é Perguntas/Perguntas.json)
# CHATBOT_PERGUNTAS_PATH=C:\caminho\para\Perguntas.json
